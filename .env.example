X_OAUTH1_ACCESS_TOKEN=
X_OAUTH1_ACCESS_TOKEN_SECRET=

# LinkedIn — App A: OAuth login + posting (Sign In with LinkedIn + Share on LinkedIn)
# This is the app users authorize when they click "Connect LinkedIn" in
# Settings. Scope: openid profile email w_member_social.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# LinkedIn — App B: Community Management API (analytics — engagement reads)
# LinkedIn REQUIRES Community Management API to be the sole product on its
# own developer app, so we can't add it to App A above. This second app is
# only used by the analytics-sync path (sync-social-metrics.ts) to read
# engagement metrics on customer posts.
# Approval-gated: fill these in AFTER LinkedIn approves the Community
# Management API request. The code checks for their presence and falls
# back gracefully if unset.
LINKEDIN_CM_CLIENT_ID=
LINKEDIN_CM_CLIENT_SECRET=

# Unsplash
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# Google OAuth (for GSC integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (Email)
RESEND_API_KEY=
# Verified sending domain in Resend. Defaults to contacts.conduikt.com.
RESEND_FROM_DOMAIN=contacts.conduikt.com

