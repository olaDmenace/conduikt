# Conduikt environment variables.
#
# Copy to .env.local for local dev; set the same names in Vercel for
# production. Every variable below is read somewhere in src/, middleware.ts
# or scripts/ (grep `process.env.NAME`). NEXT_PUBLIC_* values ship to the
# browser; everything else is server-only. Never commit real values.

# ─── App ────────────────────────────────────────────────────────────────
# Public origin, no trailing slash. OAuth callbacks and emails link here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set by Vercel ("production" | "preview" | "development"); robots.ts blocks
# crawlers on anything that is not production. Leave unset locally.
# VERCEL_ENV=

# ─── Supabase ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: cron routes, webhooks and Inngest jobs bypass RLS with it.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic / Claude ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Model routing (src/lib/ai/model-routing.ts). Defaults are set in code;
# override here to pin a cheaper or newer model.
AI_MODEL_DEFAULT=
AI_MODEL_CHEAP=
# "true" serves cached sample output for signed-out / Free previews instead
# of calling the API (no spend during demos).
AI_PREVIEW_MODE=

# ─── Security ───────────────────────────────────────────────────────────
# Shared secret for /api/cron/* — sent by pg_cron as "Authorization: Bearer".
# Must equal the Postgres setting app.cron_secret (see
# supabase/migrations/20261026_cron_jobs_header_auth.sql). openssl rand -hex 32
CRON_SECRET=
# AES-256-GCM key for OAuth tokens at rest (X, LinkedIn, TikTok, Facebook,
# GA4, GSC, YouTube). 64 hex chars: openssl rand -hex 32. Required in prod.
TOKEN_ENCRYPTION_KEY=
# Cloudflare Turnstile for the public site-check form. Unset = widget off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Where reconnect-failure alerts are emailed (src/lib/integrations/reconnect-helpers.ts).
ADMIN_ALERT_EMAIL=

# ─── Billing ────────────────────────────────────────────────────────────
# Which provider /api/billing/initialize tries first; the other is failover.
# "flutterwave" (default) or "paystack".
PAYMENT_PRIMARY_PROVIDER=flutterwave

# Flutterwave (live since 2026-04-20). Dashboard > Settings > API keys.
FLUTTERWAVE_SECRET_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
# Dashboard > Settings > Webhooks "secret hash"; arrives in the verif-hash header.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# Payment-plan IDs (numeric), monthly USD, matching $49 / $99 / $249.
FLUTTERWAVE_PLAN_PRO=
FLUTTERWAVE_PLAN_GROWTH=
FLUTTERWAVE_PLAN_AGENCY=

# Paystack (failover). Plan codes look like PLN_xxx.
# Webhook URL to register: https://conduikt.com/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_GROWTH=
PAYSTACK_PLAN_AGENCY=

# ─── Email (Resend) ─────────────────────────────────────────────────────
# One API key covers transactional sends and marketing (audiences, broadcasts).
RESEND_API_KEY=
# Verified sending domain in Resend.
RESEND_FROM_DOMAIN=contacts.conduikt.com
# Signing secret (whsec_...) for inbound webhook events. Different from the
# API key; without it the webhook route fails closed in production.
RESEND_WEBHOOK_SECRET=

# ─── Background jobs (Inngest) ──────────────────────────────────────────
INNGEST_EVENT_KEY=
# Required in production: /api/inngest refuses unsigned requests without it.
INNGEST_SIGNING_KEY=

# ─── Social publishing (OAuth apps) ─────────────────────────────────────
# X / Twitter OAuth 2.0 (user connections, posting).
X_CLIENT_ID=
X_CLIENT_SECRET=
# X OAuth 1.0a app credentials, only for media upload (src/lib/integrations/x-oauth1.ts).
X_OAUTH1_CONSUMER_KEY=
X_OAUTH1_CONSUMER_SECRET=
X_OAUTH1_ACCESS_TOKEN=
X_OAUTH1_ACCESS_TOKEN_SECRET=

# LinkedIn: Sign In with LinkedIn + Share on LinkedIn.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok for Developers (Login Kit + Content Posting API).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Facebook / Meta app. Publishing stays behind the flag until Meta business
# verification completes; set the flag to "true" to expose the connect button.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
NEXT_PUBLIC_ENABLE_FACEBOOK_INTEGRATION=false

# ─── Google (one OAuth client for GSC, GA4 and YouTube) ─────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PageSpeed Insights key for the site audit (higher quota than anonymous).
GOOGLE_PAGESPEED_API_KEY=

# ─── Media ──────────────────────────────────────────────────────────────
# Unsplash image search in the media picker.
UNSPLASH_ACCESS_KEY=
# HeyGen avatar video (video ad agent). Defaults for avatar/voice are in code.
HEYGEN_API_KEY=
HEYGEN_DEFAULT_AVATAR_ID=
HEYGEN_DEFAULT_VOICE_ID=
HEYGEN_DEFAULT_VOICE_ID_MALE=

# ─── Analytics and support widgets (marketing site) ─────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=

# ─── Missing Pages / answer engines (WS-E, keys pending) ────────────────
# DataForSEO for keyword volumes behind the intent gap finder.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Perplexity Sonar for the Found-by-AI visibility monitor.
PERPLEXITY_API_KEY=
# Domain that serves hosted pages (wildcard on Vercel).
HOSTED_PAGES_DOMAIN=conduikt.site

# ─── WhatsApp Cloud API (WS-F, needs Meta business verification) ────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ─── Personal automation (X playbook; slated to move to its own repo) ───
# football-data.org key for the PitchOdds bracket filler.
FOOTBALL_DATA_API_KEY=
