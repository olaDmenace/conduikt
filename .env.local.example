# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic / Claude ─────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Flutterwave (Billing — primary) ────────────────────────
# Get keys from https://app.flutterwave.com/dashboard/settings/apis
# Use test keys locally (FLWSECK_TEST-... / FLWPUBK_TEST-...).
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxx
# Webhook secret hash — set this in Dashboard > Settings > Webhooks.
# Flutterwave sends it verbatim in the `verif-hash` header on webhook POSTs.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# Flutterwave payment plan IDs — create these in Dashboard > Payments > Payment Plans.
# Use USD currency, monthly interval, and the matching Conduikt price ($49/$99/$249).
# Paste the numeric plan ID (not the name).
FLUTTERWAVE_PLAN_PRO=
FLUTTERWAVE_PLAN_GROWTH=
FLUTTERWAVE_PLAN_AGENCY=

# ─── Paystack (Billing — failover, currently inactive) ──────
# Paystack account pending approval. Once approved, re-enable via
# src/app/api/billing/initialize-paystack/route.ts (currently archived).
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_PLAN_PRO=PLN_xxx
PAYSTACK_PLAN_GROWTH=PLN_xxx
PAYSTACK_PLAN_AGENCY=PLN_xxx

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://conduikt.com

# ─── Post-launch (not needed for MVP) ───────────────────────
# X/Twitter OAuth (for publishing integration)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# LinkedIn OAuth (for publishing integration)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Resend (transactional email)
RESEND_API_KEY=
# Verified sending domain in Resend. Defaults to contacts.conduikt.com.
# Change this if you verify a different (sub)domain.
RESEND_FROM_DOMAIN=contacts.conduikt.com

# Inngest (background job queue)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# n8n workflow (if self-hosting n8n)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are also used by n8n
LINKEDIN_PERSON_ID=
