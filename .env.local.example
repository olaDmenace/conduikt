# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic / Claude ─────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Lemon Squeezy (Billing) ────────────────────────────────
# Webhook secret from your LS dashboard → Settings → Webhooks
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant IDs from your LS product pages
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_GROWTH=
LEMONSQUEEZY_VARIANT_AGENCY=
# Public checkout links for each plan (append ?checkout[custom][user_id]= at runtime)
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_PRO=https://yourstore.lemonsqueezy.com/checkout/buy/xxx
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_GROWTH=https://yourstore.lemonsqueezy.com/checkout/buy/xxx
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_AGENCY=https://yourstore.lemonsqueezy.com/checkout/buy/xxx
# Customer portal link (from LS dashboard → Customer Portal)
NEXT_PUBLIC_LEMONSQUEEZY_PORTAL_URL=https://yourstore.lemonsqueezy.com/billing

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://conduikt.io

# ─── Post-launch (not needed for MVP) ───────────────────────
# X/Twitter OAuth (for publishing integration)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# LinkedIn OAuth (for publishing integration)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Resend (transactional email)
RESEND_API_KEY=

# Inngest (background job queue)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# n8n workflow (if self-hosting n8n)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are also used by n8n
LINKEDIN_PERSON_ID=
