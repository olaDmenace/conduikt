# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic / Claude ─────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Paystack (Billing) ─────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_PLAN_PRO=PLN_xxx
PAYSTACK_PLAN_GROWTH=PLN_xxx
PAYSTACK_PLAN_AGENCY=PLN_xxx

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://conduikt.com

# ─── Post-launch (not needed for MVP) ───────────────────────
# X/Twitter OAuth (for publishing integration)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# LinkedIn OAuth (for publishing integration)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Resend (transactional email)
RESEND_API_KEY=

# Inngest (background job queue)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# n8n workflow (if self-hosting n8n)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are also used by n8n
LINKEDIN_PERSON_ID=
